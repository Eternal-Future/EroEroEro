# Copy to .env and fill in real values. Never commit .env.

# --- nhentai ----------------------------------------------------------------
# NHENTAI_API_KEY=
# NHENTAI_BASE=https://nhentai.net
# NHENTAI_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36

# --- e-hentai / exhentai -----------------------------------------------------
# Base Cookie (the two stable cookies), example:
# EHENTAI_COOKIE=ipb_member_id=123;ipb_pass_hash=xxxx
# EHENTAI_IGNEOUS_PROXY=http://user:pass@proxy:port  # US proxy for one-time igneous acquisition
# EHENTAI_IGNEOUS=                                   # optional: manually supply a valid igneous
# EHENTAI_STATE_DIR=.data
# EHENTAI_SQLITE_FILE=eh.sqlite                      # local SQLite file

# --- jm (禁漫 / JMComic) -----------------------------------------------------
# JM_BASE=https://www.cdngwc.cc
# JM_CDN_COVER=https://cdn-msp.jmapiproxy1.cc